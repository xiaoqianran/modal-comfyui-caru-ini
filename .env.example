# Cloudflare R2 S3 credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Hugging Face Storage Bucket S3 credentials
HF_S3_ACCESS_KEY_ID=
HF_S3_SECRET_ACCESS_KEY=

# Hugging Face API token
HF_TOKEN=

# Hugging Face model download: parallel Modal Writer containers (1-8)
MODEL_HF_DOWNLOAD_WORKERS=3

# GitHub
GITHUB_TOKEN=

# ComfyUI deployment runtime policy (set in shell or models.json runtime)
# COMFYUI_RUNTIME_PROFILE=interactive
# COMFYUI_SNAPSHOT_MODE=gpu
# COMFYUI_SCALEDOWN_SECONDS=60
# COMFYUI_WARMUP_MODE=off

# Optional CPU delivery (shell deployment settings; legacy remains default)
# COMFYUI_DELIVERY_MODE=legacy
# COMFYUI_APP_NAME=modal-my-workflow
# COMFYUI_OUTPUT_VOLUME_NAME=modal-comfyui-models-output
# COMFYUI_DELIVERY_STATE_VOLUME=modal-comfyui-delivery-state
# COMFYUI_DELIVERY_APP=modal-comfyui-delivery
# COMFYUI_DELIVERY_SCHEDULE_MINUTES=5
# COMFYUI_DELIVERY_PREVIEWS=1
